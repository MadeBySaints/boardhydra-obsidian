{
  "name": "boardhydra-obsidian",
  "version": "0.3.0",
  "description": "BoardHydra sync for Obsidian",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild test/format.test.ts --bundle --platform=node --format=cjs --outfile=build/format.test.cjs --log-level=warning && node --test build/format.test.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "yaml": "^2.6.1"
  }
}
