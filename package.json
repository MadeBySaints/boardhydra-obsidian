{
  "name": "boardhydra-obsidian",
  "version": "0.3.7",
  "description": "BoardHydra sync for Obsidian",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild test/format.test.ts --bundle --platform=node --format=cjs --outfile=build/format.test.cjs --log-level=warning && node --test build/format.test.cjs",
    "lint": "eslint ."
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.6.1"
  }
}
